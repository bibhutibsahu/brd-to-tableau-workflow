{
  "domain": "ecommerce",
  "fact_table": "fact_sales",
  "fact_alias": "f",
  "currency_symbol": "₹",
  "metrics": [
    {
      "id": "net_revenue",
      "label": "Net Revenue",
      "format": "currency",
      "description": "Revenue after discounts, excluding cancelled orders.",
      "synonyms": [
        "revenue",
        "sales",
        "net sales",
        "gmv",
        "turnover",
        "total sales",
        "income"
      ],
      "sql": "SUM(f.net_revenue)",
      "tableau": "SUM([net_revenue])",
      "dax": "SUM('fact_sales'[net_revenue])",
      "columns": [
        "net_revenue"
      ]
    },
    {
      "id": "gross_sales",
      "label": "Gross Sales",
      "format": "currency",
      "description": "List price x quantity before discounts.",
      "synonyms": [
        "gross revenue",
        "gross merchandise value",
        "mrp sales"
      ],
      "sql": "SUM(f.gross_sales)",
      "tableau": "SUM([gross_sales])",
      "dax": "SUM('fact_sales'[gross_sales])",
      "columns": [
        "gross_sales"
      ]
    },
    {
      "id": "orders",
      "label": "Orders",
      "format": "number",
      "description": "Distinct orders placed.",
      "synonyms": [
        "order count",
        "number of orders",
        "total orders",
        "transactions",
        "order volume"
      ],
      "sql": "COUNT(DISTINCT f.order_id)",
      "tableau": "COUNTD([order_id])",
      "dax": "DISTINCTCOUNT('fact_sales'[order_id])",
      "columns": [
        "order_id"
      ]
    },
    {
      "id": "units_sold",
      "label": "Units Sold",
      "format": "number",
      "description": "Total quantity of items sold.",
      "synonyms": [
        "units",
        "quantity",
        "items sold",
        "volume"
      ],
      "sql": "SUM(f.quantity)",
      "tableau": "SUM([quantity])",
      "dax": "SUM('fact_sales'[quantity])",
      "columns": [
        "quantity"
      ]
    },
    {
      "id": "customers",
      "label": "Active Customers",
      "format": "number",
      "description": "Distinct customers who placed an order.",
      "synonyms": [
        "customer count",
        "buyers",
        "unique customers",
        "active users",
        "shoppers"
      ],
      "sql": "COUNT(DISTINCT f.customer_key)",
      "tableau": "COUNTD([customer_key])",
      "dax": "DISTINCTCOUNT('fact_sales'[customer_key])",
      "columns": [
        "customer_key"
      ]
    },
    {
      "id": "new_customers",
      "label": "New Customers",
      "format": "number",
      "description": "Customers whose first ever order falls in the period.",
      "synonyms": [
        "first time buyers",
        "customer acquisition",
        "new buyers",
        "acquired customers"
      ],
      "sql": "COUNT(DISTINCT CASE WHEN f.is_first_order = 1 THEN f.customer_key END)",
      "tableau": "COUNTD(IF [is_first_order] = 1 THEN [customer_key] END)",
      "dax": "CALCULATE(DISTINCTCOUNT('fact_sales'[customer_key]), 'fact_sales'[is_first_order] = 1)",
      "columns": [
        "is_first_order",
        "customer_key"
      ]
    },
    {
      "id": "aov",
      "label": "Average Order Value",
      "format": "currency",
      "description": "Net revenue divided by orders.",
      "synonyms": [
        "aov",
        "average basket value",
        "basket size",
        "average order size",
        "avg order value"
      ],
      "sql": "SUM(f.net_revenue) * 1.0 / NULLIF(COUNT(DISTINCT f.order_id), 0)",
      "tableau": "SUM([net_revenue]) / COUNTD([order_id])",
      "dax": "DIVIDE(SUM('fact_sales'[net_revenue]), DISTINCTCOUNT('fact_sales'[order_id]))",
      "columns": [
        "net_revenue",
        "order_id"
      ]
    },
    {
      "id": "units_per_order",
      "label": "Units per Order",
      "format": "decimal",
      "description": "Average items in an order.",
      "synonyms": [
        "upt",
        "units per transaction",
        "items per order",
        "basket depth"
      ],
      "sql": "SUM(f.quantity) * 1.0 / NULLIF(COUNT(DISTINCT f.order_id), 0)",
      "tableau": "SUM([quantity]) / COUNTD([order_id])",
      "dax": "DIVIDE(SUM('fact_sales'[quantity]), DISTINCTCOUNT('fact_sales'[order_id]))",
      "columns": [
        "quantity",
        "order_id"
      ]
    },
    {
      "id": "revenue_per_customer",
      "label": "Revenue per Customer",
      "format": "currency",
      "description": "Net revenue divided by distinct customers.",
      "synonyms": [
        "arpu",
        "average revenue per user",
        "customer value",
        "spend per customer"
      ],
      "sql": "SUM(f.net_revenue) * 1.0 / NULLIF(COUNT(DISTINCT f.customer_key), 0)",
      "tableau": "SUM([net_revenue]) / COUNTD([customer_key])",
      "dax": "DIVIDE(SUM('fact_sales'[net_revenue]), DISTINCTCOUNT('fact_sales'[customer_key]))",
      "columns": [
        "net_revenue",
        "customer_key"
      ]
    },
    {
      "id": "repeat_order_rate",
      "label": "Repeat Order Rate",
      "format": "percent",
      "description": "Share of orders placed by returning customers.",
      "synonyms": [
        "repeat purchase rate",
        "returning customer orders",
        "retention",
        "repeat rate",
        "loyalty"
      ],
      "sql": "COUNT(DISTINCT CASE WHEN f.is_first_order = 0 THEN f.order_id END) * 1.0 / NULLIF(COUNT(DISTINCT f.order_id), 0)",
      "tableau": "COUNTD(IF [is_first_order] = 0 THEN [order_id] END) / COUNTD([order_id])",
      "dax": "DIVIDE(CALCULATE(DISTINCTCOUNT('fact_sales'[order_id]), 'fact_sales'[is_first_order] = 0), DISTINCTCOUNT('fact_sales'[order_id]))",
      "columns": [
        "is_first_order",
        "order_id"
      ]
    },
    {
      "id": "gross_profit",
      "label": "Gross Profit",
      "format": "currency",
      "description": "Net revenue minus cost of goods sold.",
      "synonyms": [
        "profit",
        "margin amount",
        "contribution",
        "earnings"
      ],
      "sql": "SUM(f.gross_profit)",
      "tableau": "SUM([gross_profit])",
      "dax": "SUM('fact_sales'[gross_profit])",
      "columns": [
        "gross_profit"
      ]
    },
    {
      "id": "gross_margin_pct",
      "label": "Gross Margin %",
      "format": "percent",
      "description": "Gross profit as a share of net revenue.",
      "synonyms": [
        "margin",
        "profit margin",
        "margin %",
        "profitability",
        "gross margin"
      ],
      "sql": "SUM(f.gross_profit) * 1.0 / NULLIF(SUM(f.net_revenue), 0)",
      "tableau": "SUM([gross_profit]) / SUM([net_revenue])",
      "dax": "DIVIDE(SUM('fact_sales'[gross_profit]), SUM('fact_sales'[net_revenue]))",
      "columns": [
        "gross_profit",
        "net_revenue"
      ]
    },
    {
      "id": "discount_amount",
      "label": "Discount Given",
      "format": "currency",
      "description": "Total promotional discount.",
      "synonyms": [
        "discounts",
        "promotion cost",
        "markdown",
        "coupon value",
        "promo spend"
      ],
      "sql": "SUM(f.discount_amount)",
      "tableau": "SUM([discount_amount])",
      "dax": "SUM('fact_sales'[discount_amount])",
      "columns": [
        "discount_amount"
      ]
    },
    {
      "id": "discount_rate",
      "label": "Discount Rate",
      "format": "percent",
      "description": "Discount as a share of gross sales.",
      "synonyms": [
        "discount %",
        "markdown rate",
        "promo depth",
        "discount percentage"
      ],
      "sql": "SUM(f.discount_amount) * 1.0 / NULLIF(SUM(f.gross_sales), 0)",
      "tableau": "SUM([discount_amount]) / SUM([gross_sales])",
      "dax": "DIVIDE(SUM('fact_sales'[discount_amount]), SUM('fact_sales'[gross_sales]))",
      "columns": [
        "discount_amount",
        "gross_sales"
      ]
    },
    {
      "id": "return_rate",
      "label": "Return Rate",
      "format": "percent",
      "description": "Returned value as a share of net revenue.",
      "synonyms": [
        "returns",
        "return %",
        "rto",
        "refund rate",
        "product returns"
      ],
      "sql": "SUM(f.returned_amount) * 1.0 / NULLIF(SUM(f.net_revenue), 0)",
      "tableau": "SUM([returned_amount]) / SUM([net_revenue])",
      "dax": "DIVIDE(SUM('fact_sales'[returned_amount]), SUM('fact_sales'[net_revenue]))",
      "columns": [
        "returned_amount",
        "net_revenue"
      ]
    },
    {
      "id": "returned_amount",
      "label": "Returned Value",
      "format": "currency",
      "description": "Net revenue of returned order lines.",
      "synonyms": [
        "refunds",
        "return value",
        "refund amount"
      ],
      "sql": "SUM(f.returned_amount)",
      "tableau": "SUM([returned_amount])",
      "dax": "SUM('fact_sales'[returned_amount])",
      "columns": [
        "returned_amount"
      ]
    },
    {
      "id": "cancellation_rate",
      "label": "Cancellation Rate",
      "format": "percent",
      "description": "Share of order lines that were cancelled.",
      "synonyms": [
        "cancellations",
        "cancel rate",
        "order cancellations"
      ],
      "sql": "AVG(f.is_cancelled * 1.0)",
      "tableau": "AVG([is_cancelled])",
      "dax": "AVERAGE('fact_sales'[is_cancelled])",
      "columns": [
        "is_cancelled"
      ]
    },
    {
      "id": "shipping_cost",
      "label": "Shipping Cost",
      "format": "currency",
      "description": "Total fulfilment and delivery cost.",
      "synonyms": [
        "delivery cost",
        "logistics cost",
        "fulfilment cost",
        "freight"
      ],
      "sql": "SUM(f.shipping_cost)",
      "tableau": "SUM([shipping_cost])",
      "dax": "SUM('fact_sales'[shipping_cost])",
      "columns": [
        "shipping_cost"
      ]
    },
    {
      "id": "avg_delivery_days",
      "label": "Avg Delivery Days",
      "format": "decimal",
      "description": "Average days from order to delivery.",
      "synonyms": [
        "delivery time",
        "delivery tat",
        "lead time",
        "shipping time",
        "sla"
      ],
      "sql": "AVG(f.delivery_days)",
      "tableau": "AVG([delivery_days])",
      "dax": "AVERAGE('fact_sales'[delivery_days])",
      "columns": [
        "delivery_days"
      ]
    }
  ],
  "dimension_labels": {
    "year_month": "Month",
    "quarter": "Quarter",
    "year": "Year",
    "month_name": "Month Name",
    "week_of_year": "Week",
    "day_name": "Day of Week",
    "is_weekend": "Weekend",
    "is_festive_season": "Festive Season",
    "sub_category": "Sub-Category",
    "sales_channel": "Sales Channel",
    "traffic_source": "Traffic Source",
    "device_type": "Device",
    "customer_segment": "Customer Segment",
    "age_group": "Age Group",
    "acquisition_source": "Acquisition Source",
    "signup_year_month": "Signup Month",
    "promo_name": "Promotion",
    "promo_type": "Promotion Type",
    "city_tier": "City Tier",
    "price_band": "Price Band",
    "order_status": "Order Status",
    "payment_method": "Payment Method",
    "product_name": "Product",
    "customer_name": "Customer"
  },
  "temporal_dimensions": [
    "year_month",
    "quarter",
    "year",
    "week_of_year",
    "full_date",
    "signup_year_month"
  ],
  "excluded_dimensions": [
    "date_key",
    "full_date",
    "sku",
    "order_line_id",
    "discount_pct",
    "signup_date"
  ],
  "chart_types": [
    "kpi",
    "bar",
    "horizontal_bar",
    "line",
    "pie",
    "table"
  ],
  "chart_rules": {
    "temporal": "line",
    "share_max_categories": 4,
    "horizontal_bar_min_categories": 7,
    "default_top_n": 10
  },
  "default_filters": [
    "dim_date.year_month",
    "dim_geography.region",
    "dim_product.category",
    "dim_channel.sales_channel"
  ]
}
