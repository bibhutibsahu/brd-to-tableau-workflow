# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Gemini API key (https://aistudio.google.com/apikey). GOOGLE_API_KEY is accepted as a fallback.
# It can also be entered in the app sidebar instead.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Gemini model used by default.
GEMINI_MODEL=gemini-3.5-flash

# Sampling temperature for LLM calls.
# LLM_TEMPERATURE=0.1

# SQLite star-schema database the BRD is mapped onto.
# DATABASE_PATH=data/ecommerce.db

# BRD text beyond this many characters is cut before it is sent to the LLM.
# MAX_BRD_CHARS=60000

# Rows returned per preview query.
# PREVIEW_ROW_LIMIT=500
